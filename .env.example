# Postgres connection string. The Prisma provider is postgresql.
# Local Docker:
#   docker run --name relayboard-postgres \
#     -e POSTGRES_USER=relayboard -e POSTGRES_PASSWORD=relayboard -e POSTGRES_DB=relayboard \
#     -p 5432:5432 -d postgres:16
# Neon: use the pooled URL here. If Neon also gives a direct URL, set
# DATABASE_URL_UNPOOLED to that direct URL (vercel-build uses it for db push).
DATABASE_URL="postgresql://relayboard:relayboard@localhost:5432/relayboard"
# DATABASE_URL_UNPOOLED="postgresql://relayboard:relayboard@localhost:5432/relayboard"

# Long random string. The value below is for local demo only.
AUTH_SECRET="dev-only-secret-change-me-before-any-deploy-0123456789abcdef"
