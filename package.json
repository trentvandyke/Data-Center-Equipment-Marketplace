{
  "name": "grid-asset-exchange",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/ensure-env.mjs && prisma generate",
    "build": "node scripts/ensure-env.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "setup": "node scripts/setup.mjs",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed && tsx scripts/import-inventory.ts data/inventory/recs_2026-11-24.json && tsx scripts/scrub-public.ts",
    "import:inventory": "tsx scripts/import-inventory.ts",
    "crawl": "tsx scripts/crawl.ts",
    "test": "tsx --test src/lib/match/score.test.ts src/lib/crawl/robots.test.ts src/lib/images/extract.test.ts src/lib/public-surface.test.tsx src/lib/public-copy.test.ts",
    "backfill:images": "tsx scripts/backfill-images.ts",
    "scrub:public": "tsx scripts/scrub-public.ts",
    "images:to-blob": "tsx scripts/images-to-blob.ts",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
